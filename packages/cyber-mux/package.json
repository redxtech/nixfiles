{
  "name": "cyber-mux",
  "version": "0.4.0",
  "description": "Cross-multiplexer pane control - one contract over tmux and herdr",
  "type": "module",
  "bin": {
    "cyber-mux": "bin/cyber-mux.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./worktree": {
      "types": "./dist/worktree.d.mts",
      "default": "./dist/worktree.mjs"
    },
    "./template": {
      "types": "./dist/template.d.mts",
      "default": "./dist/template.mjs"
    },
    "./agent": {
      "types": "./dist/agent.d.mts",
      "default": "./dist/agent.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "dependencies": {
    "commander": "^14.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
