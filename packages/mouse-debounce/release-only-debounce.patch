+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const WINDOW: Duration = Duration::from_millis(50);
+
+    #[test]
+    fn accepts_double_click_at_or_after_release_deadline() {
+        let start = Instant::now();
+        let release = start + Duration::from_millis(10);
+        for gap in [50, 62, 75, 81, 86, 88] {
+            let mut buttons = ButtonStates::new(1);
+            assert!(buttons.press(0));
+            buttons.release(0, release, WINDOW);
+            assert_eq!(
+                buttons.drain_due(release + Duration::from_millis(gap)),
+                [(release + WINDOW, 0)]
+            );
+            assert!(buttons.press(0));
+        }
+    }
+
+    #[test]
+    fn repress_cancels_release_until_a_full_uninterrupted_window() {
+        let start = Instant::now();
+        let at = |ms| start + Duration::from_millis(ms);
+        let mut buttons = ButtonStates::new(1);
+        assert!(buttons.press(0));
+        buttons.release(0, at(10), WINDOW);
+        assert!(buttons.drain_due(at(51)).is_empty());
+        assert!(!buttons.press(0));
+        buttons.release(0, at(55), WINDOW);
+        assert!(buttons.drain_due(at(70)).is_empty());
+        buttons.release(0, at(100), WINDOW);
+        assert!(buttons.drain_due(at(104)).is_empty());
+        assert_eq!(buttons.drain_due(at(105)), [(at(105), 0)]);
+        assert!(buttons.drain_due(at(200)).is_empty());
+    }
+
+    #[test]
+    fn buttons_drain_independently_in_deadline_order() {
+        let start = Instant::now();
+        let mut buttons = ButtonStates::new(3);
+        for (code, ms) in [(0, 50), (1, 40), (2, 10)] {
+            assert!(buttons.press(code));
+            buttons.release(code, start, Duration::from_millis(ms));
+        }
+        assert!(!buttons.press(2));
+        assert_eq!(
+            buttons.drain_due(start + WINDOW),
+            [(start + Duration::from_millis(40), 1), (start + WINDOW, 0)]
+        );
+        assert!(!buttons.press(2));
+    }
+}
