+struct ButtonStates {
+    pressed: Vec<bool>,
+    release_deadlines: HashMap<usize, Instant>,
+}
+
+impl ButtonStates {
+    fn new(count: usize) -> Self {
+        Self {
+            pressed: vec![false; count],
+            release_deadlines: HashMap::new(),
+        }
+    }
+
+    fn press(&mut self, code: usize) -> bool {
+        self.release_deadlines.remove(&code);
+        !std::mem::replace(&mut self.pressed[code], true)
+    }
+
+    fn release(&mut self, code: usize, now: Instant, dur: Duration) {
+        if self.pressed[code] {
+            // duplicate release events do not interrupt a continuous release
+            self.release_deadlines
+                .entry(code)
+                .or_insert_with(|| deadline_after(now, dur));
+        }
+    }
+
+    fn drain_due(&mut self, now: Instant) -> Vec<(Instant, usize)> {
+        let mut due = Vec::new();
+        self.release_deadlines.retain(|&code, deadline| {
+            if now < *deadline {
+                return true;
+            }
+            self.pressed[code] = false;
+            due.push((*deadline, code));
+            false
+        });
+        due.sort_unstable();
+        due
+    }
 }

